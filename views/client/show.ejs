<%- include('../partials/head', { title }) %>
<%
  var nextBy = {
    new: 'Ждёт прораба.',
    offered: 'Ждёт мастера.',
    accepted: 'Мастер назначен.',
    in_progress: 'Идёт работа.',
    done: 'Готово.',
    cancelled: 'Отменена.'
  };
  function tone(offer) {
    if (!offer || offer.status === 'cancelled') return 'cancelled';
    if (offer.status === 'open') return 'open';
    if (offer.job_status === 'in_progress') return 'in_progress';
    if (offer.job_status === 'done') return 'done';
    return 'accepted';
  }
%>
<p class="back"><a href="/client">Заявки</a></p>
<p class="kicker">Заявка <%= request.id %></p>
<h1><%= KINDS[request.kind] %></h1>
<p class="status-line">
  <span class="tag lg tag-<%= request.status %>"><%= statusLabel %></span>
  <span class="num muted"><%= formatDate(request.updated_at) %></span>
</p>
<p class="next-note"><%= nextBy[request.status] || '' %></p>
<dl class="facts">
  <div><dt>Адрес</dt><dd><%= request.address %></dd></div>
  <div><dt>Задача</dt><dd><%= request.description %></dd></div>
  <% if (request.status_note) { %>
    <div><dt>Заметка</dt><dd><%= request.status_note %></dd></div>
  <% } %>
</dl>
<section class="sec">
  <h2>Вызовы</h2>
  <% if (!offers.length) { %>
    <p class="empty">Вызовов нет.</p>
  <% } else { %>
    <ul class="plain">
      <% offers.forEach(function (offer) { %>
        <li class="item">
          <p class="item-title"><%= SPECIALTIES[offer.specialty] %></p>
          <p><span class="tag tag-<%= tone(offer) %>"><%= offerLabel(offer) %></span></p>
          <% if (offer.master_name) { %>
            <p class="meta"><%= offer.master_name %> · <a class="tel" href="tel:+<%= offer.master_phone %>"><%= formatPhone(offer.master_phone) %></a></p>
          <% } %>
          <p class="meta num"><%= formatDate(offer.accepted_at || offer.created_at) %></p>
          <% if (offer.summary && request.kind === 'apartment') { %>
            <p><%= offer.summary %></p>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<% if (request.status === 'new' || request.status === 'offered') { %>
  <form method="post" action="/client/requests/<%= request.id %>/cancel" class="sec">
    <%- include('../partials/csrf') %>
    <button class="text-btn danger" type="submit">Отменить заявку</button>
  </form>
<% } %>
<%- include('../partials/foot') %>

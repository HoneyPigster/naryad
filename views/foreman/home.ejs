<%- include('../partials/head', { title, board: true }) %>
<div class="page-head">
  <div>
    <h1>Задачи</h1>
    <p class="lede"><span class="num"><%= formatMoney(price) %></span> за объект. Деньги не списываются.</p>
  </div>
  <% if (tasks.length) { %>
    <a class="btn" href="/foreman/tasks/new">Дать задачу</a>
  <% } %>
</div>
<% if (!tasks.length) { %>
  <div class="empty">
    <p>Задач нет. Опишите работу — мастер своей специальности сможет откликнуться.</p>
    <a class="btn" href="/foreman/tasks/new">Дать задачу</a>
  </div>
<% } else { %>
  <div class="rows">
    <% tasks.forEach(function (item) { %>
      <a class="row" href="/foreman/tasks/<%= item.id %>">
        <span class="row-title"><%= item.address %></span>
        <span class="row-go"><%= item.responses ? item.responses + ' откл.' : 'Ждёт' %></span>
        <span class="row-meta"><%= SPECIALTIES[item.specialty] %></span>
        <span class="row-next"><%= item.summary %></span>
      </a>
    <% }) %>
  </div>
<% } %>
<%- include('../partials/foot') %>

<%- include('../partials/head', { title }) %>
<%
  var tone = 'accepted';
  if (offer.status === 'open') tone = 'open';
  else if (offer.status === 'cancelled') tone = 'cancelled';
  else if (offer.job_status === 'in_progress') tone = 'in_progress';
  else if (offer.job_status === 'done') tone = 'done';
%>
<p class="back"><a href="/master">Кабинет</a></p>
<p class="kicker"><%= SPECIALTIES[offer.specialty] %> · <%= offer.object_id ? 'от прораба' : 'от клиента' %></p>
<h1><%= offer.address %></h1>
<p class="status-line">
  <span class="tag lg tag-<%= tone %>"><%= offerLabel(offer) %></span>
  <span class="num muted"><%= formatDate(offer.accepted_at || offer.created_at) %></span>
</p>
<dl class="facts">
  <div><dt>Задача</dt><dd><%= offer.summary %></dd></div>
  <div><dt>Контакт</dt><dd><%= offer.contact_name %> · <a class="tel" href="tel:+<%= offer.contact_phone %>"><%= formatPhone(offer.contact_phone) %></a></dd></div>
  <% if (offer.status_note) { %>
    <div><dt>Заметка</dt><dd><%= offer.status_note %></dd></div>
  <% } %>
</dl>
<% if (offer.status === 'open') { %>
  <form method="post" action="/master/offers/<%= offer.id %>/accept" class="sec">
    <%- include('../partials/csrf') %>
    <button class="btn" type="submit">Принять заказ</button>
  </form>
<% } else if (offer.master_id === user.id) { %>
  <form method="post" action="/master/offers/<%= offer.id %>/status" class="stack sec">
    <%- include('../partials/csrf') %>
    <fieldset>
      <legend>Статус</legend>
      <label class="choice"><input type="radio" name="job_status" value="accepted" <%= offer.job_status === 'accepted' ? 'checked' : '' %>> Принят</label>
      <label class="choice"><input type="radio" name="job_status" value="in_progress" <%= offer.job_status === 'in_progress' ? 'checked' : '' %>> В работе</label>
      <label class="choice"><input type="radio" name="job_status" value="done" <%= offer.job_status === 'done' ? 'checked' : '' %>> Готово</label>
    </fieldset>
    <div class="field">
      <label for="status_note">Заметка</label>
      <textarea id="status_note" name="status_note" maxlength="500"><%= offer.status_note || '' %></textarea>
    </div>
    <button class="btn" type="submit">Сохранить</button>
  </form>
<% } %>
<%- include('../partials/foot') %>

<% if (role === 'inspector') { %>
  <div class="draw draw-inspector" aria-hidden="true">
    <span class="draw-inspector-mark">Пр</span>
    <span class="draw-inspector-caption">Приёмка</span>
  </div>
<% } else { %>
<picture class="draw draw-<%= role %>">
  <source type="image/webp" srcset="/drawings/<%= role %>.webp">
  <img src="/drawings/<%= role %>.jpg" width="600" height="500" alt="<%= role === 'foreman' ? 'Прораб у дома с планшетом' : 'Мастер с инструментом' %>" decoding="async">
</picture>
<% } %>

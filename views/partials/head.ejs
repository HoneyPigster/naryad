<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Наряд</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/app.css?v=16">
  <meta name="theme-color" content="#e4e9e5">
</head>
<body class="<%= user ? 'role-' + user.role : 'role-guest' %><%= (typeof home !== 'undefined' && home) ? ' page-home' : '' %>">
  <a class="skip" href="#content">К содержанию</a>
  <header class="top">
    <a class="mark" href="<%= user ? HOME[user.role] : '/' %>"><span class="mark-stamp" aria-hidden="true"></span><span class="mark-word">Наряд</span></a>
    <% if (user) { %>
      <div class="who">
        <p class="who-role" title="<%= ROLES[user.role] %><% if (user.role === 'master' && user.specialty) { %> · <%= SPECIALTIES[user.specialty] %><% } %> <%= user.full_name %>">
          <span class="role-label"><%= ROLES[user.role] %><% if (user.role === 'master' && user.specialty) { %> · <%= SPECIALTIES[user.specialty] %><% } %></span>
          <span class="who-name"><%= user.full_name %></span>
        </p>
        <a class="nav-link" href="/inspection">Приёмка</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="text-btn" type="submit">Выйти</button>
        </form>
      </div>
    <% } else { %>
      <nav class="who" aria-label="Вход">
        <a class="nav-link" href="/login">Войти</a>
        <a class="nav-link" href="/inspection">Приёмка</a>
        <a class="nav-cta" href="/register">Регистрация</a>
      </nav>
    <% } %>
  </header>
  <main id="content" class="<% if (typeof home !== 'undefined' && home) { %>home<% } else { %>wrap<% if (typeof wide !== 'undefined' && wide) { %> wide<% } else if (typeof board !== 'undefined' && board) { %> board<% } %><% } %>">
    <% if (flash) { %>
      <p class="banner <%= flash.type === 'error' ? 'is-error' : 'is-ok' %>" role="status"><%= flash.text %></p>
    <% } %>

<%
  var roleLabel = values.role === 'foreman' ? 'Прораб' : values.role === 'master' ? 'Мастер' : 'Приёмка';
  var roleHeading = values.role === 'foreman' ? 'Регистрация прораба' : values.role === 'master' ? 'Регистрация мастера' : 'Регистрация для приёмки';
%>
<%- include('partials/head', { title, wide: true }) %>
<p class="back"><a href="/register">К выбору</a></p>
<div class="role-screen">
  <div class="role-figure">
    <%- include('partials/drawing', { role: values.role }) %>
  </div>
  <div>
    <p class="kicker"><%= roleLabel %></p>
    <h1><%= roleHeading %></h1>
    <p class="lede">Оплата не подключена, деньги не списываются.</p>
    <% if (errors.form) { %><p class="banner is-error" role="alert"><%= errors.form %></p><% } %>
    <form method="post" action="/register/<%= values.role %>" class="stack">
      <%- include('partials/csrf') %>
      <input type="hidden" name="role" value="<%= values.role %>">
      <% if (values.role === 'master') { %>
        <fieldset>
          <legend id="specialty-label">Специальность</legend>
          <div class="pick" role="radiogroup" aria-labelledby="specialty-label">
            <% Object.entries(SPECIALTIES).forEach(function ([key, label]) { %>
              <label class="choice"><input type="radio" name="specialty" value="<%= key %>" <%= values.specialty === key ? 'checked' : '' %> required> <%= label %></label>
            <% }) %>
          </div>
          <% if (errors.specialty) { %><p class="field-error" role="alert"><%= errors.specialty %></p><% } %>
        </fieldset>
      <% } %>
      <div class="field">
        <label for="full_name">Имя</label>
        <input id="full_name" name="full_name" autocomplete="name" required value="<%= values.full_name %>" <%= errors.full_name ? 'aria-invalid="true" aria-describedby="name-err"' : '' %>>
        <% if (errors.full_name) { %><p class="field-error" id="name-err" role="alert"><%= errors.full_name %></p><% } %>
      </div>
      <div class="field">
        <label for="phone">Телефон</label>
        <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+7 900 000-00-00" value="<%= values.phone %>" <%= errors.phone ? 'aria-invalid="true" aria-describedby="phone-err"' : '' %>>
        <% if (errors.phone) { %><p class="field-error" id="phone-err" role="alert"><%= errors.phone %></p><% } %>
      </div>
      <div class="field">
        <label for="password">Пароль</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" <%= errors.password ? 'aria-invalid="true" aria-describedby="password-err"' : '' %>>
        <p class="hint">От 8 символов.</p>
        <% if (errors.password) { %><p class="field-error" id="password-err" role="alert"><%= errors.password %></p><% } %>
      </div>
      <button class="btn" type="submit">Создать кабинет</button>
      <p class="hint">Уже есть кабинет? <a href="/login/<%= values.role %>">Войти</a></p>
    </form>
  </div>
</div>
<%- include('partials/foot') %>

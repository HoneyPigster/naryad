# Пароль базы. Без символов @ : / # ? &
POSTGRES_PASSWORD=change-me-please

# Длинная случайная строка. Например: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Домен без схемы (naryad.example.ru) или :80, если домена нет.
# На голый IP сертификат Let's Encrypt не выпускается.
SITE_ADDRESS=:80

# Почта для Let's Encrypt. Нужна, когда SITE_ADDRESS — домен.
ACME_EMAIL=you@example.ru

# 1 — если заходите по https. 0 — если сайт открыт только по http (:80).
COOKIE_SECURE=0

# Каталог фото внутри контейнера приложения. Другого пути в коде нет.
PHOTO_DIR=/data/photos

# Локальный запуск без Docker (npm start):
# DATABASE_URL=postgres://naryad:naryad@127.0.0.1:5432/naryad
# PHOTO_DIR=./data/photos
# COOKIE_SECURE=0
# SESSION_SECRET=dev-only-secret
